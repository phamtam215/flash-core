{
  "permissions": {
    "allow": [
      "Bash(docker *)",
      "Bash(open -a Docker)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(node *)",
      "Bash(npx *)",
      "Bash(bun *)",
      "Bash(php *)",
      "Bash(python3 *)",
      "Bash(curl *)",
      "Bash(tar *)",
      "Bash(md5 *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(wc *)",
      "Bash(cp *)",
      "Bash(mkdir *)",
      "mcp__claude_ai_ClickUp__*",
      "mcp__claude_ai_Figma__*"
    ]
  },
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": ["*"],
      "allowLocalBinding": true,
      "allowMachLookup": ["org.chromium.*", "com.apple.*"]
    },
    "filesystem": {
      "allowWrite": [
        "worktrees",
        "worktrees/**",
        "azv-perf-track/.git/worktrees",
        "azv-perf-track/.git/worktrees/**"
      ],
      "allowRead": ["azv-perf-track/.env.example", "azv-perf-track/.env.test.example", "~/.ssh"]
    },
    "enableWeakerNestedSandbox": true,
    "excludedCommands": [
      "open -a Docker",
      "docker *",
      "node *",
      "npx playwright *",
      "git push *",
      "git fetch *",
      "git pull *",
      "git worktree *"
    ]
  }
}