# Copy file này thành `.env` rồi điền giá trị thật. `.env` KHÔNG BAO GIỜ được commit.
# Mọi biến ở đây được validate bằng Zod lúc khởi động (src/config/env.schema.ts) —
# thiếu hoặc sai định dạng thì app fail ngay, không fail lúc 3h sáng khi có request đầu tiên.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Khớp docker-compose.yml. Khi deploy Phase 6 thì trỏ sang Neon (dùng connection string
# có pooler — xem docs/adr/ khi tới phase đó).
DATABASE_URL=postgresql://flashcore:flashcore@localhost:5432/flashcore?schema=public

# Số connection tối đa của pg.Pool. Biến này quan trọng ở Phase 3: pool nhỏ + pessimistic
# lock = request fail vì "hết pool", một nguyên nhân khác hẳn "lock contention".
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379

# Chiến lược chống oversell — Phase 3. Ba giá trị: optimistic | pessimistic | redis.
# Mặc định TẠM là optimistic; giá trị chính thức cho production sẽ được chốt bằng ADR
# sau khi có số benchmark k6 (project-context.md §6).
INVENTORY_STRATEGY=optimistic

# ── Phase 4: Async, Queue & Payment ────────────────────────────────────────────────────
# Thời gian giữ chỗ đơn PENDING (phút). Integration test tự đặt xuống vài giây.
ORDER_HOLD_MINUTES=15

# Khoá ký webhook thanh toán — BẮT BUỘC, tối thiểu 32 ký tự, không có giá trị mặc định.
# Sinh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET=doi-chuoi-nay-thanh-32-ky-tu-ngau-nhien-that

# Chữ ký cũ hơn ngần này giây thì từ chối (chống replay).
PAYMENT_WEBHOOK_TOLERANCE=300

# Worker: số job xử lý song song, nhịp quét outbox và số dòng mỗi lô.
QUEUE_CONCURRENCY=5
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
