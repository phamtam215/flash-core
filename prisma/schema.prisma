// Schema Prisma của Flash-Core (Prisma 7).
//
// Khác biệt quan trọng của Prisma 7 so với các bản trước (v6 và tài liệu cũ trên mạng):
//   1. `datasource` KHÔNG còn chứa `url` — connection string chuyển sang `prisma.config.ts`.
//   2. `PrismaClient` phải nhận một **driver adapter** (ở đây là `@prisma/adapter-pg`,
//      dùng thư viện `pg`) thay vì tự quản kết nối bằng Rust engine.
//   3. Generator là `prisma-client` (không phải `prisma-client-js`) và cần `output`
//      tường minh → code sinh ra nằm trong repo, không nằm trong node_modules.
//
// Điểm (2) hoá ra là điều TỐT cho dự án này: connection pool giờ là `pg.Pool` do mình cấu
// hình, nên số connection trở thành thứ nhìn thấy và điều chỉnh được — đúng bài toán của
// Phase 3 (pool cạn khi pessimistic lock) và Phase 7 (Neon pooler).
//
// Phase 1 thêm `User` và `RefreshToken` (spec: docs/specs/phase1-auth.md).
// Phase 2 thêm `Product` và `ProductSku` (spec: docs/specs/phase2-product-inventory.md).
// Phase 3 thêm `Order` và `OrderItem` (spec: docs/specs/phase3-order-concurrency.md), và cột
// `ProductSku.version` cho chiến lược optimistic.
// Phase 4 thêm `OutboxEvent`, `ProcessedEvent`, `RefundRequest` và ba cột thanh toán trên
// `Order` (spec: docs/specs/phase4-async-queue-payment.md).
//
// Ghi chú cho phase sau:
// - Tồn kho theo SKU biến thể (size × màu) — quyết định #2 trong project-context.md. Nằm ở
//   `ProductSku`, không phải `Product`.
// - Tiền lưu Int (VND, không phần thập phân). Không dùng Float cho tiền.
// - `CHECK (stock >= 0)` phải viết bằng migration raw SQL (Prisma không có API cho check
//   constraint). Đó là lưới an toàn cuối chống oversell — Phase 2 CHƯA chống race condition
//   thật (đó là Phase 3), CHECK chỉ đảm bảo không âm dù tầng ứng dụng có bug.
// - `SELECT ... FOR UPDATE` cũng phải dùng `$queryRaw` trong `$transaction` interactive.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Bảng kỹ thuật duy nhất của Phase 0: để `prisma generate` có model mà sinh client, và
/// để integration test có thứ thật để ghi/đọc khi kiểm chứng kết nối DB.
/// Phase 6 sẽ dùng lại nó để lưu mốc kiểm tra readiness.
model HealthProbe {
  id        String   @id @default(uuid()) @db.Uuid
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("health_probe")
}

/// Tài khoản người dùng.
///
/// Chỉ lưu `passwordHash`, KHÔNG bao giờ lưu mật khẩu thô. Hash bằng Argon2id — thuật toán
/// memory-hard, cố tình tốn RAM để GPU không thử hàng tỷ mật khẩu mỗi giây được.
/// Salt nằm sẵn bên trong chuỗi hash của Argon2 nên không cần cột riêng.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  refreshTokens RefreshToken[]
  orders        Order[]

  @@map("users")
}

/// Refresh token đã cấp cho user.
///
/// Vì sao phải lưu (khác access token — thứ không lưu ở đâu cả): chỉ khi server giữ một bản
/// ghi thì mới **thu hồi** được. Access token stateless nên còn hạn là còn dùng được, kể cả
/// sau khi logout — đó là lý do nó phải sống ngắn.
///
/// `tokenHash`: lưu SHA-256 của token, KHÔNG lưu token thô. Cùng lý do với mật khẩu — DB rò
/// rỉ thì kẻ tấn công vẫn không đăng nhập được. Dùng SHA-256 (không phải Argon2) vì token đã
/// là chuỗi ngẫu nhiên đủ dài, không cần chống dò từ điển, và bước này chạy ở mọi lần refresh
/// nên phải nhanh.
///
/// `familyId`: mọi token sinh ra từ **một lần đăng nhập** dùng chung một familyId. Khi phát
/// hiện một token đã bị vô hiệu mà vẫn có người dùng lại (reuse detection), thu hồi **cả
/// family** chứ không riêng token đó — vì lúc đó không biết ai là chủ thật, ai là kẻ trộm.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Tra theo user khi logout-tất-cả; tra theo family khi reuse detection thu hồi cả chuỗi.
  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SkuSize {
  S
  M
  L
  XL
  XXL
}

/// Mẫu áo. KHÔNG có giá, KHÔNG có tồn kho — hai thứ đó thuộc về SKU, không thuộc Product.
model Product {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  slug        String        @unique
  description String?
  status      ProductStatus @default(DRAFT)

  /// Thuộc tính MỞ, không cần lọc chính xác cao tần và khác nhau tuỳ mẫu: chất liệu, hoạ
  /// tiết, xuất xứ, hướng dẫn giặt là... Size/màu KHÔNG nằm ở đây, xem `ProductSku` — đó là
  /// dữ liệu có tập giá trị đóng, cần validate và join/filter thường xuyên, JSONB làm mất cả
  /// hai khả năng đó (không `CHECK` được enum, không index rẻ bằng B-tree).
  attributes Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  skus ProductSku[]

  @@index([attributes], type: Gin)
  @@map("products")
}

/// Biến thể bán được thật sự: một tổ hợp size × màu của một Product. Tồn kho gắn Ở ĐÂY,
/// không phải ở Product — "sản phẩm còn hàng" là suy ra từ "còn SKU nào của nó stock > 0".
model ProductSku {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  size      SkuSize
  color     String
  skuCode   String  @unique @map("sku_code") // mã đọc được cho vận hành, vd AOTHUN-DEN-M
  priceVnd  Int     @map("price_vnd") // VND, Int — không Float cho tiền
  stock     Int
  isActive  Boolean @default(true) @map("is_active")

  /// Tăng 1 mỗi lần tồn kho đổi — dùng cho chiến lược optimistic (Phase 3).
  ///
  /// Cột này KHÔNG cần thiết để chống oversell: `UPDATE ... WHERE stock >= ?` đã an toàn ngay
  /// ở Read Committed, vì Postgres đánh giá lại `WHERE` trên phiên bản mới nhất sau khi chờ
  /// khoá. Nó có mặt để (a) so sánh đúng nghĩa "optimistic locking" trong benchmark, (b) sẵn
  /// sàng cho trường hợp phải update nhiều field phụ thuộc nhau.
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  // Một product không có 2 SKU trùng size+màu — lưới chặn double-submit ở tầng DB.
  @@unique([productId, size, color])
  // Phục vụ keyset pagination của GET /skus (WHERE (created_at, id) < (...) ORDER BY ...).
  @@index([createdAt, id])
  @@index([productId])
  @@map("product_skus")
}

enum OrderStatus {
  PENDING /// đã giữ chỗ, chờ thanh toán
  PAID /// Phase 4 chuyển sang khi webhook thanh toán xác nhận
  CANCELLED /// Phase 4: hết 15 phút tự hủy, hoặc user tự hủy
}

/// Đơn hàng.
///
/// `idempotencyKey` + `UNIQUE(userId, idempotencyKey)` LÀ cơ chế chống double-submit: DB là
/// trọng tài duy nhất. Cách sai là `SELECT` xem key tồn tại chưa rồi mới `INSERT` — giữa hai
/// bước đó có request khác chen vào được, đúng kiểu lost update mà cả phase này đang chống.
/// UNIQUE theo `userId` (không phải toàn cục) để hai user tình cờ gửi cùng một chuỗi không
/// chặn nhau.
model Order {
  id     String      @id @default(uuid()) @db.Uuid
  userId String      @map("user_id") @db.Uuid
  status OrderStatus @default(PENDING)

  /// Tổng tiền chốt tại thời điểm đặt = Σ(unitPriceVnd × quantity). Int, VND.
  totalVnd       Int    @map("total_vnd")
  idempotencyKey String @map("idempotency_key")

  /// Mốc hết hạn giữ chỗ (createdAt + 15 phút). Phase 3 chỉ GHI cột này — job tự hủy khi quá
  /// hạn là deliverable của Phase 4 (BullMQ delayed job).
  expiresAt DateTime @map("expires_at")

  /// Phase 4. Mốc thời gian của hai đường ra khỏi `PENDING`, để trả lời được "đơn này chốt
  /// lúc nào" mà không phải suy từ `updatedAt` (cột đó đổi vì bất cứ lý do gì).
  paidAt      DateTime? @map("paid_at")
  cancelledAt DateTime? @map("cancelled_at")

  /// Mã phiên thanh toán từ cổng. UNIQUE để một phiên không gắn được vào hai đơn.
  paymentIntentId String? @unique @map("payment_intent_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User            @relation(fields: [userId], references: [id])
  items   OrderItem[]
  refunds RefundRequest[]

  @@unique([userId, idempotencyKey])
  // Tra đơn của một user, mới nhất trước — phục vụ keyset pagination của GET /orders.
  @@index([userId, createdAt, id])
  // Phase 4 quét đơn PENDING đã quá hạn.
  @@index([status, expiresAt])
  @@map("orders")
}

/// Một dòng trong đơn.
///
/// `unitPriceVnd` là SNAPSHOT PRICE — copy giá SKU tại thời điểm đặt, KHÔNG join lấy giá hiện
/// tại khi đọc đơn. Lý do: sale kết thúc, giá SKU về giá gốc, mà đơn đã chốt thì số tiền không
/// được đổi theo. Đây cũng là lý do client KHÔNG được gửi giá lên trong body.
model OrderItem {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  skuId        String   @map("sku_id") @db.Uuid
  quantity     Int
  unitPriceVnd Int      @map("unit_price_vnd")
  createdAt    DateTime @default(now()) @map("created_at")

  order Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku   ProductSku @relation(fields: [skuId], references: [id])

  @@index([orderId])
  @@index([skuId])
  @@map("order_items")
}

// ── Phase 4: Async, Queue & Payment ─────────────────────────────────────────────────────

enum OutboxStatus {
  PENDING /// chưa đẩy vào queue
  DISPATCHED /// đã đẩy, không xử lý lại
  FAILED /// cạn số lần thử ở khâu đẩy — cần người xem
}

/// Hộp thư đi (Outbox pattern).
///
/// Vấn đề nó giải: `await db.save()` rồi `await queue.add()` là **dual write** — hai hệ thống
/// khác nhau, không transaction nào bao được cả hai. Chết ở giữa thì DB có đơn mà queue không
/// có việc, và `try/catch` không cứu được (lệnh đầu đã commit rồi). Cách duy nhất đúng: ghi ý
/// định vào **cùng transaction** với dữ liệu, rồi để một tiến trình riêng đọc ra và đẩy đi.
///
/// Nó KHÔNG cho exactly-once: đẩy queue xong mà chết trước khi `UPDATE status='DISPATCHED'`
/// thì lần sau đẩy lại. Nó đổi bài toán từ "có thể **mất**" sang "có thể **trùng**" — và trùng
/// thì consumer idempotent xử lý được, còn mất thì không có cách nào cứu.
model OutboxEvent {
  id          String @id @default(uuid()) @db.Uuid
  aggregate   String /// 'order'
  aggregateId String @map("aggregate_id") @db.Uuid
  type        String /// 'order.placed', 'order.paid', ...

  payload Json @db.JsonB

  status       OutboxStatus @default(PENDING)
  attempts     Int          @default(0)
  lastError    String?      @map("last_error")
  createdAt    DateTime     @default(now()) @map("created_at")
  dispatchedAt DateTime?    @map("dispatched_at")

  /// Relay quét đúng dòng cần đẩy, cũ trước. Index này LÀ điều kiện để `FOR UPDATE SKIP
  /// LOCKED` rẻ — thiếu nó thì mỗi vòng quét là một Seq Scan trên bảng chỉ có tăng.
  @@index([status, createdAt])
  @@map("outbox_events")
}

/// Dấu "đã xử lý rồi" của consumer — thứ biến at-least-once thành *exactly-once processing*.
///
/// Idempotency ở đây do UNIQUE của DB quyết định, y hệt cách `Idempotency-Key` làm ở Phase 3:
/// cứ `INSERT`, va UNIQUE thì biết là bản trùng và thoát êm. Cách sai vẫn là cách cũ —
/// `SELECT` xem đã xử lý chưa rồi mới xử lý — vì hai worker chạy song song lọt qua khe giữa
/// hai bước đó.
///
/// Khoá gồm cả `consumer`: cùng một sự kiện có thể có nhiều người tiêu thụ (gửi email, cộng
/// điểm thưởng...), mỗi người phải được xử lý đúng một lần của riêng mình.
model ProcessedEvent {
  eventId     String   @map("event_id")
  consumer    String
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([eventId, consumer])
  @@map("processed_events")
}

/// Tiền đã vào nhưng đơn không còn nhận được (đã huỷ, hoặc số tiền lệch).
///
/// KHÔNG tự hoàn tiền và KHÔNG im lặng: ghi lại đầy đủ + log mức `error`. Ba cách xử lý sai đã
/// ghi ở tech-playbook §Phase 4 — bỏ qua webhook (khách mất tiền), hồi sinh đơn `CANCELLED`
/// thành `PAID` (tạo oversell ở đường sau), hoặc tự hoàn tiền mà không để lại dấu vết.
model RefundRequest {
  id              String @id @default(uuid()) @db.Uuid
  orderId         String @map("order_id") @db.Uuid
  paymentIntentId String @map("payment_intent_id")
  amountVnd       Int    @map("amount_vnd")

  /// 'ORDER_ALREADY_CANCELLED' | 'AMOUNT_MISMATCH'
  reason        String
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  /// Webhook lặp lại không được tạo hai yêu cầu hoàn tiền cho cùng một phiên thanh toán.
  @@unique([paymentIntentId])
  @@index([orderId])
  @@map("refund_requests")
}
