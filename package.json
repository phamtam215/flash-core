{
  "name": "flash-core",
  "version": "0.1.0",
  "description": "API Engine cho hệ thống săn flash sale áo thun — Modular Monolith, tập trung vào concurrency và reliability",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main",
    "worker": "ts-node src/worker.ts",
    "worker:prod": "node dist/worker",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test,prisma}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,test,prisma}/**/*.{ts,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:int": "node --experimental-vm-modules node_modules/.bin/jest --config ./test/jest-integration.json --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "seed": "ts-node prisma/seed/seed-skus.ts",
    "docs:html": "node scripts/build-docs-html.mjs",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.28",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.22.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
