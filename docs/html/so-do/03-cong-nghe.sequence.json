  "cards": [
    {
      "dot": "cyan",
      "title": "Vì sao PostgreSQL giữ vai chính",
      "items": [
        "Điều kiện chống bán vượt nằm trong chính câu ghi, rồi đọc số dòng bị ảnh hưởng",
        "Ba cơ chế dùng thật: UPDATE … WHERE, SELECT FOR UPDATE, FOR UPDATE SKIP LOCKED",
        "Prisma không có API cho FOR UPDATE nên $queryRaw bị giới hạn trong đúng một file (ADR-003)"
      ]
    },
    {
      "dot": "violet",
      "title": "Vì sao Redis phải là Lua",
      "items": [
        "Redis chạy lệnh tuần tự một luồng nên script chạy trọn vẹn",
        "GET rồi DECRBY từ Node chỉ đổi chỗ race condition, không xoá nó",
        "Redis nhanh nhưng không chung ACID với Postgres nên lỗi sau đó phải bù trừ ngược"
      ]
    },
    {
      "dot": "amber",
      "title": "Vì sao BullMQ + outbox",
      "items": [
        "await db.save() rồi await queue.add() mà chết ở giữa là mất việc — try/catch không cứu được",
        "BullMQ có sẵn trên Redis: delayed job (huỷ 15 phút), retry, DLQ — chưa cần Kafka",
        "QUEUE_PREFIX tách job của test khỏi worker đang chạy trên máy dev"
      ]
    },
    {
      "dot": "emerald",
      "title": "Phần còn lại của stack",
      "items": [
        "Zod: type suy ra TỪ schema nên không bao giờ lệch với validator",
        "Argon2id memory-hard 19 MiB nên GPU không song song hoá như với bcrypt",
        "Pino + AsyncLocalStorage: correlationId đi xuyên cả worker (ADR-008)"
      ]
    }
  ]
